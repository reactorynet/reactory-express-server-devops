# Terraform working directories and provider binaries.
#
# .terraform.lock.hcl is deliberately NOT ignored — Terraform expects it to be
# committed so every checkout resolves the same provider versions.
**/.terraform/*
.terraform.tfstate.lock.info

# State — blueprints use remote S3 state; any local state file is either a
# leftover or the minikube blueprint's, and must never be committed.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files carry credentials. Only the .example files belong in git.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Plan files contain resolved variable values, including secrets.
*.tfplan
*.plan

# Crash and debug logs
crash.log
crash.*.log
.logs/

# Terraform-generated override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
