# ---------------------------------------------------------------------------
# staging / cluster — copy to terraform.tfvars (gitignored).
# ---------------------------------------------------------------------------

aws_region  = "us-west-1"
project     = "reactory"
environment = "staging"

# Keep equal to production so upgrades are rehearsed here first.
kubernetes_version = "1.30"

api_allowed_cidrs = ["0.0.0.0/0"]

node_instance_types = ["t3.large"]
node_desired_count  = 2
node_max_count      = 4

# Smallest sizes that still exercise each managed service.
docdb_instance_class      = "db.t3.medium"
rds_max_capacity          = 4
valkey_node_type          = "cache.t4g.small"
opensearch_instance_type  = "t3.small.search"
opensearch_volume_size_gb = 20

postgres_database = "reactory"

# --- Secrets: export before applying -------------------------------------
#   export TF_VAR_mongo_username="reactory"
#   export TF_VAR_mongo_password="..."
#   export TF_VAR_postgres_username="reactory"
#   export TF_VAR_postgres_password="..."
#   export TF_VAR_valkey_auth_token="..."           # 16-128 chars, no / " @
#   export TF_VAR_opensearch_username="reactory_admin"
#   export TF_VAR_opensearch_password="..."         # upper, lower, digit, symbol
#   export TF_VAR_grafana_admin_password="..."
#   export TF_VAR_app_secret_key="..."
