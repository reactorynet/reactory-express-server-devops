APPLICATION_ROOT=src
REACTORY_APPLICATION_EMAIL=reactory@reactory.net
SYSTEM_USER_ID=reactory@reactory.net
SERVER_ID=reactory-local
APP_DATA_ROOT=/app/reactory/reactory-data
APP_SYSTEM_FONTS=/usr/share/fonts
MONGOOSE=mongodb://reactory:reactorycore@localhost:27017/reactory-reactory?socketTimeoutMS=360000&connectTimeoutMS=360000&authSource=admin
MODULES_ENABLED=enabled-reactory
CLIENTS_ENABLED=enabled-clients.reactory
API_PORT=4000
SENDGRID_API_KEY=SG.disabled
API_URI_ROOT=http://localhost:4000
# Origin used when minting SSE endpoint URLs for the browser. Defaults to
# API_URI_ROOT. Browsers pool HTTP/1.1 connections per origin and allow six; an
# SSE stream holds one open for its whole life, and on a default deployment
# GraphQL, the REST routes and the CDN all share that same six. Pointing this at
# a different origin for the same host gives the streams their own pool. An
# alias is enough — 127.0.0.1 and localhost are separate origins to the browser
# — so this needs no extra listener, proxy or certificate.
SSE_URI_ROOT=http://127.0.0.1:4000
# Cross-process fanout for streaming events. The transport registry is
# per-process memory and the server runs many processes (pm2 cluster inside
# every replica), so the SSE connection and the turn that produces its events
# routinely land on different workers. Events are published to Redis per
# conversation so whichever process holds the transport can deliver them. Set to
# "off" only for a genuinely single-process deployment.
REACTORY_STREAMING_FANOUT=on
# Keepalive comment interval for idle SSE streams, in ms. Must stay comfortably
# below the reverse proxy's read timeout (ingress-nginx defaults to 60s; the
# terraform envs raise it to 3600s).
REACTORY_STREAMING_HEARTBEAT_MS=25000
CDN_ROOT=http://localhost:4000/cdn
SECRET_SAUCE=YOUR_SECRET_SAUCE_HERE
##
# Use I18N_NS to specify the namespaces that should be loaded for internationalization. This should be a comma-separated list of namespaces that correspond to the translation files in the locales directory. For example, if you have translation files for "reactory", "reactor", and "booktutor", you would set I18N_NS to "reactory,reactor,booktutor". This allows the application to load the appropriate translations based on the specified namespaces.
##
I18N_NS=reactory
MODE=development
SYSADMIN_EMAIL=reactory@reactory.net

POSTGRES_DB=reactory
POSTGRES_USER=reactory
POSTGRES_PASSWORD=SUPER_SECRET_POSTGRES_PASSWORD
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432

MONGO_DB=reactory-reactory
MONGO_USER=reactory
MONGO_PASSWORD=SUPER_SECRET_PASSWORD
MONGO_PORT=27017
MONGO_HOST=localhost

# Service image versions — override to pin to a specific release
MONGO_VERSION=8.0
POSTGRES_VERSION=17
REDIS_VERSION=7.4
MEILISEARCH_VERSION=v1.13
JAEGER_VERSION=1.76.0
GRAFANA_VERSION=12.4.4
LOKI_VERSION=3.7.2
PROMETHEUS_VERSION=v3.12.0

# Service ports — override if defaults conflict with other local services
POSTGRES_PORT=5432
REDIS_PORT=6379
MEILISEARCH_PORT=7700
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686
LOKI_PORT=3100
PROMETHEUS_PORT=9090
NODE_ENV=development

REACTORY_APP_WHITELIST=http://localhost:3000,http://localhost:4000/,https://studio.apollographql.com

REACTORY_APPLICATION_KEY=reactory
REACTORY_APPLICATION_USERNAME=reactory
REACTORY_APPLICATION_PASSWORD=SUPER_SECRET_REACTORY_APPLICATION_PASSWORD
REACTORY_APPLICATION_URL=http://localhost:3000


REACTOR_APPLICATION_EMAIL=reactor@reactor.local
REACTOR_APPLICATION_USERNAME=reactor
REACTOR_APPLICATION_PASSWORD=SUPER_SECRET_REACTOR_APPLICATION_PASSWORD

REACTOR_ANONUSER_EMAIL=anon@reactor.local
REACTOR_ANONUSER_PASSWORD=SUPER_SECRET_REACTOR_ANONUSER_PASSWORD
REACTOR_APPLICATION_URL=http://localhost:3002
REACTOR_APPLICATION_PORT=3002

MAIL_REDIRECT_ENABLED=development
MAIL_REDIRECT_ADDRESS=your_redirect@mail.com
##
# Microsoft OAuth configuration for authentication. These settings are used to enable users to log in using their Microsoft accounts. The MICROSOFT_OAUTH_APP_ID and MICROSOFT_OAUTH_APP_PASSWORD should be obtained from the Azure portal when you register your application. The MICROSOFT_OAUTH_REDIRECT_URI should match the redirect URI configured in your Azure app registration. The MICROSOFT_OAUTH_SCOPES define the permissions that your application is requesting from the user's Microsoft account. The MICROSOFT_OAUTH_AUTHORITY is the URL of the Microsoft identity platform, and the MICROSOFT_OAUTH_ID_METADATA, AUTHORIZE_ENDPOINT, and TOKEN_ENDPOINT specify the endpoints for authentication and token exchange.
##
MICROSOFT_OAUTH_APP_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_OAUTH_APP_PASSWORD=00000000-0000-0000-0000-000000000000
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:4000/auth/microsoft/openid/complete
MICROSOFT_OAUTH_SCOPES="profile offline_access user.read calendars.read mail.read email"
MICROSOFT_OAUTH_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_OAUTH_ID_METADATA=/v2.0/.well-known/openid-configuration
MICROSOFT_OAUTH_AUTHORIZE_ENDPOINT=/oauth2/v2.0/authorize
MICROSOFT_OAUTH_TOKEN_ENDPOINT=/oauth2/v2.0/token

##
# Google AI Studio API configuration for integrating with Google's AI services. The GOOGLE_AI_STUDIO_API_KEY is the API key that you obtain from the Google Cloud Console when you enable the AI Studio API. The GOOGLE_AI_STUDIO_PROJECT_ID is the ID of your Google Cloud project, and the GOOGLE_AI_STUDIO_MODEL_ID is the identifier for the specific AI model you want to use within AI Studio. These settings allow your application to authenticate and interact with Google's AI services for tasks such as natural language processing, machine learning, and other AI capabilities.
## 
GOOGLE_AI_STUDIO_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
GOOGLE_AI_STUDIO_PROJECT_ID=YOUR_GOOGLE_AI_STUDIO_PROJECT_ID
GOOGLE_AI_STUDIO_MODEL_ID=YOUR_GOOGLE_AI_STUDIO_MODEL_ID

##
# OLLAMA_API_BASE_URL is the base URL for the Ollama API, which is used for AI model hosting and inference. The X_AI_API_BASE_URL and X_AI_API_KEY are used for integrating with the X AI platform, allowing your application to make authenticated requests to X AI services. The OPENAI_API_BASE_URL is the endpoint for OpenAI's API, enabling access to OpenAI's language models and other AI capabilities. The ANTHROPIC_API_BASE_URL and ANTHROPIC_API_KEY are used for integrating with Anthropic's AI services, providing access to their language models and tools. Make sure to replace the placeholder values with your actual API keys and endpoints to enable proper integration with these AI platforms.
##
OLLAMA_API_BASE_URL=http://localhost:11434/v1

##
# X_AI_API_BASE_URL is the base URL for the X AI platform, which provides various AI services and capabilities. The X_AI_API_KEY is the API key that you need to authenticate your requests to the X AI platform. This key should be obtained from the X AI platform when you register your application. By setting these environment variables, you can enable your application to interact with the X AI services for tasks such as natural language processing, machine learning, and other AI functionalities.
##
X_AI_API_BASE_URL=https://api.x.ai/v1
X_AI_API_KEY=YOUR_X_AI_API_KEY

##
#
##
OPENAI_API_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

##
# IS_DESKTOP_INSTALL is a flag that indicates whether the application is being installed as a desktop application. 
# Setting this to true may enable certain features or configurations that are specific to desktop environments, 
# such as file system access or native notifications. 
# If you are installing the application in a desktop environment, set this to true; otherwise, you can set it to false for web-based deployments.
# Used when packaging the application with the Electron App
## 
IS_DESKTOP_INSTALL=true

###
# X Client configuration for integration with the X / twitter platform. 
# These settings include the X_CLIENT_ID, X_CLIENT_SECRET, and X_BEARER_TOKEN, which are required for authenticating API requests to the X AI platform. You can obtain these credentials by registering your application with the X AI platform and generating the necessary API keys and tokens. 
# Make sure to replace the placeholder values with your actual credentials to enable proper integration with the X AI services.
##
X_CLIENT_ID=YOUR_X_CLIENT_ID
X_CLIENT_SECRET=YOUR_X_CLIENT_SECRET
X_BEARER_TOKEN=YOUR_X_BEARER_TOKEN