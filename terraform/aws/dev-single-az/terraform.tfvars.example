# ---------------------------------------------------------------------------
# Example tfvars for dev-single-az
# Copy to terraform.tfvars and fill in real values.
# DO NOT commit terraform.tfvars to source control.
# Use TF_VAR_* environment variables in CI/CD pipelines instead.
# ---------------------------------------------------------------------------

aws_region  = "us-west-1"
project     = "reactory"
environment = "dev"

image_tag = "1.1.0"

# Optional — leave empty to skip ACM/HTTPS
domain_name = ""

# Non-secret overrides (safe to commit)
mongo_database    = "reactory-dev"
postgres_database = "reactory"
