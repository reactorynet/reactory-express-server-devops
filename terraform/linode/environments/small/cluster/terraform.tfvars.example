# ---------------------------------------------------------------------------
# linode / small / cluster — copy to terraform.tfvars (gitignored).
#
# Managed data services at this tier: none — every data service is a pod
# ---------------------------------------------------------------------------

project = "reactory"
tier    = "small"
region = "us-ord"

# Required environment:
#   export LINODE_TOKEN="..."
#
# State backend (Object Storage):
#   export TF_STATE_BUCKET=reactory-tfstate-CHANGEME
#   export TF_STATE_ENDPOINT=https://us-ord-1.linodeobjects.com
#   export AWS_ACCESS_KEY_ID=<state_access_key>
#   export AWS_SECRET_ACCESS_KEY=<state_secret_key>
